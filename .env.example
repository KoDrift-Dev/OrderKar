# ── OrderKar SaaS — environment template ──────────────────────────────
# Copy to `.env.local` and fill in. NEVER commit real keys.
# Get these from: Supabase Dashboard → Project Settings → API

# Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" / "publishable" key (safe for browser use — RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: the service_role key must NEVER be used in this codebase, not even in
# server code. All access goes through the anon key + RLS policies.

# Cloudinary image storage (optional for direct uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
