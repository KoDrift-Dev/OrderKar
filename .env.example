# ── OrderKar SaaS — environment template ──────────────────────────────
# Copy to `.env.local` and fill in. NEVER commit real keys.
#
# Two groups below:
#   PUBLIC (NEXT_PUBLIC_*) — bundled into the browser JS. Safe ONLY because
#     Supabase RLS + server-side checks protect the data; never put a secret
#     behind a NEXT_PUBLIC_ name.
#   SERVER-ONLY — read only in API routes / server code. Never expose these
#     to the client.

# ═══════════════════════════════════════════════════════════════════
# PUBLIC — Supabase (required)
# Get these from: Supabase Dashboard → Project Settings → API
# ═══════════════════════════════════════════════════════════════════

# Supabase project URL, e.g. https://xyzcompany.supabase.co
# Missing → every page shows "Supabase not configured"; nothing works.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" / "publishable" key (safe for browser use — RLS protects data)
# Missing → same as above. NOTE: the service_role key must NEVER be used in
# this codebase, not even in server code. All access goes through the anon
# key + RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ═══════════════════════════════════════════════════════════════════
# PUBLIC — Images (optional but recommended)
# ═══════════════════════════════════════════════════════════════════

# Cloudinary cloud name for browser-side menu/staff photo uploads.
# Missing → photo uploads are disabled (menu items fall back to no photo).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary UNSIGNED upload preset (e.g. "orderkr").
# Missing → uploads disabled. Keep the preset locked to image types and a
# folder in the Cloudinary dashboard to limit abuse.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Image CDN base URL (Cloudflare Worker), e.g. https://cdn.orderkar.pk
# cdnUrl() rewrites stored image URLs through this for edge caching.
# Missing → original storage URLs are used directly (works, just slower).
NEXT_PUBLIC_IMAGE_CDN=

# ═══════════════════════════════════════════════════════════════════
# PUBLIC — URLs / domains (optional)
# ═══════════════════════════════════════════════════════════════════

# Canonical app URL used for Stripe checkout/portal redirects.
# Missing → falls back to the request origin, then a hardcoded default.
NEXT_PUBLIC_APP_URL=

# Root domain for tenant subdomains, e.g. orderkar.pk
# Used by middleware ({slug}.orderkar.pk → /r/[slug]) and QR code URLs.
# Missing → defaults to "orderkar.pk".
NEXT_PUBLIC_ROOT_DOMAIN=

# ═══════════════════════════════════════════════════════════════════
# SERVER-ONLY — Stripe billing (optional / parked)
# Only needed if online subscription billing is enabled.
# If STRIPE_SECRET_KEY is missing, billing APIs return 503 with a friendly
# message and the owner console shows the "billing not configured" state.
# ═══════════════════════════════════════════════════════════════════

# Stripe secret key (sk_live_... or sk_test_...). NEVER expose to the client.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...) from the Stripe Dashboard webhook endpoint.
# Used to verify POST /api/billing/webhook signatures. Missing → webhooks rejected.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for the three subscription plans.
# Missing → checkout for that plan fails with a clear error.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ═══════════════════════════════════════════════════════════════════
# SERVER-ONLY — AI menu scanner (optional)
# Only needed for the "Scan Menu" button (owner/manager).
# If unset, the scan API returns 503 with a friendly message.
# ═══════════════════════════════════════════════════════════════════

# Base URL of an OpenAI-compatible chat-completions endpoint.
# Works with OpenAI, Azure OpenAI, or OpenRouter.
# Missing → defaults to https://api.openai.com/v1
VISION_API_URL=

# API key for the vision provider. NEVER expose to the client.
# Missing → menu scanning disabled (503).
VISION_API_KEY=

# Model name, e.g. gpt-4o-mini.
# Missing → defaults to gpt-4o-mini
VISION_MODEL=
